# Copy to `.env.local` and fill in. Public values are read by the HTTP
# interceptor (`src/services/interceptor`) and exposed through
# `src/config/env.ts`; server-only values are read by the API route handlers.

# Base URL of the staff API (the .NET service in ~/DotNetProj/myOzoneDotNet;
# `dotnet run --launch-profile http` serves it on port 5080). The HTTP client
# appends the trailing slash. Relative (`/api/v1`): the browser calls this
# app's own origin and Next forwards to API_ORIGIN below — this is what makes
# the app work from a phone on the LAN. Absolute: called directly (the API's
# CORS must then allow this app's origin).
NEXT_PUBLIC_BASE_API=/api/v1

# Server only: where Next forwards `/api/v1/*` (see next.config.ts). Needed
# with a relative NEXT_PUBLIC_BASE_API; leave unset with an absolute one.
API_ORIGIN=http://localhost:5080

# Route (relative to the site origin) the auth middleware redirects to when a
# session cannot be recovered.
NEXT_PUBLIC_FALLBACK=login

# Endpoint that exchanges a refresh token for a new access token (same
# origin rules as NEXT_PUBLIC_BASE_API). The API rotates the refresh token on
# every call; the interceptor stores both.
NEXT_PUBLIC_REFRESH_TOKEN_ROUTE=/api/v1/auth/refresh

# ---------------------------------------------------------------- server only
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
# Used by `src/app/api/mattermost/status/route.ts` (Protection Proxy) to set
# the signed-in user's status / custom status in Mattermost.

# Mattermost server origin, without a trailing slash. Leave both empty to
# disable the sync (the app then skips it without warnings).
MATTERMOST_URL=

# Personal access token of a Mattermost account allowed to edit other users'
# statuses (a system admin or a bot with the `manage_system` permission).
MATTERMOST_TOKEN=
